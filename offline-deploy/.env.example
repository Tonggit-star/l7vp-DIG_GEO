# 本文件只用于替换 docker-compose.yml 里的 ${...}。
# ⚠️ 这些变量【不会】自动成为容器环境变量 —— compose 的 .env 只做文件内插值。
#    要让某个值进容器，必须在 docker-compose.yml 的 environment: 里显式引用它。
#
# 用法：cp .env.example .env，按需改。.env 本身不要提交（里面有达梦口令）。

# ---------------------------------------------------------------- 宿主机端口
# 左边是宿主机端口，右边是容器内固定端口（3001 HTTP / 3002 WS / 8081 Flink）。
L7VP_HTTP_PORT=3003
L7VP_WS_PORT_HOST=3002
FLINK_UI_PORT=8081
FLINK_RPC_PORT=6123
TSDB_PORT=5432

# ------------------------------------------------------------------ 达梦
# 达梦不参与本编排（没有公开镜像，只能用官网 tar 包 docker load）。
# 这里指向「容器外面」那台达梦：
#   - 达梦在内网某台机器上          → 写那个 IP（**推荐，实测可用的就是这种**）
#   - 达梦跑在另一个容器里          → 改成那个容器的 service 名，并把它接进同一网络
#   - 达梦跑在宿主机自己的 Docker 里 → host.docker.internal（需 extra_hosts，已配）
#
# ⚠️ 别想当然用 host.docker.internal 指宿主机。实测（WSL2 + Docker）同一台达梦：
#      WSL 宿主直接连 192.168.1.35:5236  → 不通
#      容器内  连     192.168.1.35:5236  → 通
#    宿主机到不了那个网段，容器反而能到。写 host.docker.internal 会连到
#    「连不通的宿主机」，表现为连接超时。
DM_HOST=192.168.1.35
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=

# ------------------------------------------------------------------ 时序库
# 原部署用自建镜像 kag-ts-postgis:latest（仓库里没有它的构建脚本），
# 默认换成公开的 timescale/timescaledb-ha:pg17，同样自带 PostGIS 3。
# 口令两处必须一致：这里的 TSDB_* 管容器初始化，compose 里的 FLINK_TSDB_* 管应用读取。
# 注意 POSTGRES_* 只在【空卷】首次初始化时生效，改了对已有数据卷无效。
TSDB_IMAGE=timescale/timescaledb-ha:pg17
TSDB_DB=maritime
TSDB_USER=kag
TSDB_PASSWORD=kag@timescale
TSDB_TABLE=stream_events
# 数据卷名钉死为旧名，衔接既有数据（stream_events 历史轨迹表）。改这个 = 换一个空卷。
TSDB_VOLUME_NAME=kag-njupt_timescale_data

# ------------------------------------------------------------------ 应用镜像
L7VP_IMAGE=l7vp-server:1.0.0

# ------------------------------------------------------------------ Flink
# ⚠️ 作业 jar 按 Flink 1.17.2 编译，集群版本必须对齐，别用 1.18。
FLINK_IMAGE=flink:1.17.2-scala_2.12
FLINK_TASK_SLOTS=3
# 保存项目时是否为含 kafka 配置的流式数据集自动提交作业。
# 本地验证建议 false：没有真 Kafka 时开着只会刷错误日志。
FLINK_AUTO_START=false

# ---------------------------------------------------- 登录 / 中台 / 流式鉴权
# local = 免登录本地开放访问，不依赖中台 SSO（本地开发/验证用这个）
# sso   = 中台单点登录，需要同时配好地址与 OAuth 客户端凭据
L7VP_AUTH_MODE=local
ZHONGTAI_BASE_URL=http://10.16.1.6:8081
APP_FRONTEND_URL=http://localhost:3003

# 流式推送鉴权令牌，留空 = 不强制鉴权（仅限内网/受控环境）
L7VP_STREAM_PUSH_TOKEN=

# ------------------------------------------------------------------ 杂项
TZ=Asia/Shanghai
